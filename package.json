{
  "name": "lablens",
  "private": true,
  "version": "2.0.0",
  "description": "LabLens web app: private, on-device lab report extraction and review",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/test-ui-buttons.mjs",
    "benchmark:ocr": "node scripts/run-ocr-benchmark.mjs",
    "benchmark:ocr:live": "LABLENS_OCR_LIVE=1 node scripts/test-ui-buttons.mjs",
    "build:web": "node scripts/build-web.mjs",
    "probe:parser": "node scripts/run-report-parser.mjs",
    "probe:pdf": "node scripts/probe-pdf-parser.mjs",
    "dev": "node scripts/dev-server.mjs",
    "probe:curation": "node scripts/probe-curation.mjs"
  }
}
